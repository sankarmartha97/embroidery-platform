{
  "name": "embroidery-web",
  "version": "0.1.0",
  "private": true,
  "description": "Studio web app (Next.js): projects, editor shell, canvas, autosave, jobs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 5001",
    "build": "next build",
    "start": "next start -p 5001",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
