# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL (docker compose maps 3307 -> 3306)
DATABASE_URL=mysql://emb:emb@127.0.0.1:3307/embroidery
DB_POOL_SIZE=10
# Local only: create a stub users(id CHAR(36)) table before migrating.
# The real users table belongs to the existing marketplace (OQ-03).
DB_CREATE_USERS_STUB=true

# Auth: JWTs issued by the existing marketplace (A5). Use JWKS in real environments,
# or a PEM public key for local development.
AUTH_JWT_ISSUER=https://auth.example.com/
AUTH_JWT_AUDIENCE=embroidery-api
AUTH_JWKS_URL=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ALGORITHMS=RS256,ES256

# Roles are loaded server-side, never from token claims. Until the marketplace
# role source is connected (A5), assign roles per user id here (JSON).
DEV_ROLE_ASSIGNMENTS={}

# Rate limiting (per user, else per IP), requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# AWS (LocalStack in development)
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL_EMB_JOBS=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/emb-jobs
S3_BUCKET_ARTIFACTS=emb-artifacts-local

# Worker: wall-time limit per job attempt and heartbeat interval (ms). WORKER_ID defaults to host:pid.
JOB_TIMEOUT_MS=600000
JOB_HEARTBEAT_MS=15000

# Format registry: allow formats that have not passed the production gate (dev/staging only)
FORMATS_ALLOW_UNGATED=true
